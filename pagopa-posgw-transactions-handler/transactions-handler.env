# OpenTelemetry configuration for SigNoz
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=always_on
OTEL_SERVICE_NAME=posgw-transactions-handler
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

## Azure Service Bus
# Connection strings
LOCAL_CONNECTION_STRING=Endpoint=sb://pagopa-posgw-azure-service-bus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICE_BUS_ECOMMERCE_SYNC_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_ECOMMERCE_SYNC_RETRY_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_GEC_SYNC_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_GEC_SYNC_RETRY_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_SESSION_POLL_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_SESSION_EXPIRE_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_SYSTEM_TELEMETRY_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"

# Queues
SERVICE_BUS_ECOMMERCE_SYNC_QUEUE_NAME=posgw.cmd.ecommerce.sync
SERVICE_BUS_ECOMMERCE_SYNC_RETRY_QUEUE_NAME=posgw.cmd.ecommerce.sync.retry
SERVICE_BUS_GEC_SYNC_QUEUE_NAME=posgw.cmd.gec.sync
SERVICE_BUS_GEC_SYNC_RETRY_QUEUE_NAME=posgw.cmd.gec.sync.retry
SERVICE_BUS_SESSION_POLLING_QUEUE_NAME=posgw.cmd.session.poll
SERVICE_BUS_SESSION_EXPIRE_QUEUE_NAME=posgw.cmd.session.expire

# Topic
SERVICE_BUS_SYSTEM_TELEMETRY_TOPIC_NAME=posgw.evt.sys.telemetry