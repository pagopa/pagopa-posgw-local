{
  "name": "pagopa-posgw-psp-mock",
  "version": "0.0.1",
  "private": true,
  "description": "Mock of the PSP POS layer APIs for local POS Gateway development",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "pspSpecRef": "c52a47fe89c96642cbb71153cf9e956f5216f4c4"
  },
  "scripts": {
    "generate": "openapi-typescript https://raw.githubusercontent.com/pagopa/pagopa-api/$npm_package_config_pspSpecRef/openapi/psp_pos_layer.json -o src/generated/psp-pos-layer.ts",
    "prebuild": "npm run generate",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
