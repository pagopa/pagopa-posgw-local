            "value": "31293847112"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{HOST}}/debt-positions/{{orgFiscalCode}}/{{IUPD}}/invalidations",
          "host": [
