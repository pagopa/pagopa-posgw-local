  },
  "item": [
    {
      "name": "Create a new debt position",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"IUPD\", `POSGW-INTEGRATION-TEST-${getId(5)}`);",
              "pm.environment.set(\"IUV\", `95000${getId(12)}`);",
              "",
              "function getId(size) {",
              "  return Math.floor(Math.random() * (10 ** size)).toString().padStart(size, '0');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"[pagopa-posgw-debtposition-handler] Create a new debt position\", () => {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
              "value": "Ocp-Apim-Subscription-Key",
              "type": "string"
            },
            {
              "key": "value",
              "value": "{{apiKey}}",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "x-correlation-id",
            "value": "04714f49-d79d-4fe0-bbb3-2fd43afc2af4",
            "description": "Subsequent api call correlation field. This should be the same for all api's invoked in a given user session to track each call and for troubleshooting"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyName\": \"Ente Creditore Test\",\n  \"iupd\": \"{{IUPD}}\",\n  \"officeName\": \"Sportello POS\",\n  \"switchToExpired\": false,\n  \"debtor\": {\n    \"type\": \"G\",\n    \"fiscalCode\": \"ROSMRI87A04H501K\",\n    \"fullName\": \"Mario Rossi\"\n  },\n  \"paymentOption\": {\n    \"installment\": {\n      \"transferList\": [\n        {\n          \"amount\": {{AMOUNT}},\n          \"remittanceInformation\": \"/RFB/{{IUV}}/CNR/ROSMRI87A04H501K/TXT/POSGW Integration Test {{IUPD}}\",\n          \"iban\": \"IT60X0542811101000000123456\",\n          \"category\": \"9/0101108TS/\"\n        }\n      ],\n      \"iuv\": \"{{IUV}}\",\n      \"description\": \"POSGW Integration Test {{IUPD}}\",\n      \"dueDate\": \"2024-12-31T23:59:59Z\",\n      \"installmentMetadata\": {\n        \"channel\": \"POS\"\n      }\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{HOST}}/debt-positions",
          "host": [
            "{{HOST}}"
          ],
          "path": [
            "debt-positions"
          ]
        },
        "description": "Trigger a position creation invoking external service"
      },
      "response": []
    },
    {
