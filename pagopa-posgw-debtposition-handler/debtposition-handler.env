# OpenTelemetry configuration for SigNoz
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=always_on
OTEL_SERVICE_NAME=posgw-debtposition-handler
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# GDP Service properties (NOTE: we are using traefik to root requests to mocks)
GPD_URI=http://localhost:80/gpd-mock
GPD_TIMEOUT=1000
GPD_CONNECTION_TIMEOUT=1000
GPD_API_KEY=primary-key

# Redis
REDIS_HOST=pagopa-posgw-redis
REDIS_PORT=6379
REDIS_PASSWORD="redis_password"
REDIS_TIMEOUT=2s
REDIS_CONNECTION_TIMEOUT=2s